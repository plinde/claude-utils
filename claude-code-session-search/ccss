#!/usr/bin/env bash
#
# ccss - Claude Code Session Search
#
# Browse and search recent Claude Code sessions from ~/.claude/projects
#
# Usage: ccss [options] [count]
#   -n COUNT      Number of sessions to show
#   -a            Include agent/subagent sessions
#   --all         Include agents + show ALL sessions (no count limit)
#   -s, --short   Use shortened paths (gh:, ws:, ~/)
#   -v, --verbose Show extra info (refs, file path, message count)
#   -g, --grep    Search sessions for keyword (case-sensitive)
#   -S, --search  Search message content and display matching lines
#   --context N   Message context around search matches (default: 1)
#   --max-per-session N  Max matches per session (default: 10)
#   -i            Case-insensitive search (use with -g or -S)
#   -j, --json    Output as JSON
#   --from DATE   Only show sessions on or after DATE
#   --to DATE     Only show sessions on or before DATE
#   --by-start    Filter date range by session start time
#   --by-last     Filter date range by last activity (default)
#   --here        Only show sessions for current directory
#   -f, --fzf     Interactive fzf mode - filter and select session to resume
#   --path-only   Show unique project paths with timestamps (for cd, not resume)
#   --ignore PATH Add a path to the global ignore list
#   --unignore PATH Remove a path from the ignore list
#   --list-ignored  Show all ignored paths
#   -h, --help    Show help
#

# Configuration
PROJECTS_DIR="${HOME}/.claude/projects"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/claude-code-session-search"
IGNORE_FILE="${CONFIG_DIR}/ignore"
DEFAULT_COUNT=10
FZF_DEFAULT_COUNT=100

# Colors
C_CYAN='\033[36m'
C_YELLOW='\033[33m'
C_GRAY='\033[90m'
C_MAGENTA='\033[35m'
C_GREEN='\033[92m'
C_BLUE='\033[94m'
C_ORANGE='\033[93m'
C_BOLD='\033[1m'
C_RESET='\033[0m'

# Helper: Ensure config directory exists
ensure_config_dir() {
    [[ ! -d "$CONFIG_DIR" ]] && mkdir -p "$CONFIG_DIR"
}

# Helper: Add path to ignore list
add_ignore() {
    local path="$1"
    ensure_config_dir
    # Normalize path (remove trailing slash)
    path="${path%/}"
    # Check if already ignored
    if [[ -f "$IGNORE_FILE" ]] && grep -qxF "$path" "$IGNORE_FILE" 2>/dev/null; then
        echo "Path already ignored: $path"
        return 0
    fi
    echo "$path" >> "$IGNORE_FILE"
    echo "Added to ignore list: $path"
}

# Helper: Remove path from ignore list
remove_ignore() {
    local path="$1"
    path="${path%/}"
    if [[ ! -f "$IGNORE_FILE" ]]; then
        echo "No ignore file found"
        return 1
    fi
    if ! grep -qxF "$path" "$IGNORE_FILE" 2>/dev/null; then
        echo "Path not in ignore list: $path"
        return 1
    fi
    # Remove the line (macOS compatible)
    # Use || true because grep returns 1 when no lines match (file becomes empty)
    local tmp
    tmp=$(mktemp)
    grep -vxF "$path" "$IGNORE_FILE" > "$tmp" || true
    mv "$tmp" "$IGNORE_FILE"
    echo "Removed from ignore list: $path"
}

# Helper: List all ignored paths
list_ignored() {
    if [[ ! -f "$IGNORE_FILE" ]] || [[ ! -s "$IGNORE_FILE" ]]; then
        echo "No paths ignored"
        echo "Ignore file: $IGNORE_FILE"
        return 0
    fi
    echo "Ignored paths ($IGNORE_FILE):"
    while IFS= read -r line; do
        [[ -n "$line" ]] && echo "  $line"
    done < "$IGNORE_FILE"
}

# Helper: Check if path should be ignored
is_ignored() {
    local path="$1"
    path="${path%/}"
    [[ ! -f "$IGNORE_FILE" ]] && return 1
    grep -qxF "$path" "$IGNORE_FILE" 2>/dev/null
}

# Helper: Extract last user prompt from a session file
get_last_prompt() {
    local filepath="$1"
    grep '"type":"user"' "$filepath" 2>/dev/null | \
        jq -r 'select(.message.content | type == "string") | .message.content' 2>/dev/null | \
        grep -v '^\[Request' | \
        tail -1 | \
        tr '\n' ' ' | \
        sed 's/  */ /g' | \
        head -c 80
}

# Helper: Extract references from a session file
get_refs() {
    local filepath="$1"
    local urls jira branches

    # HTTP URLs - filter out noise and fragments
    urls=$(grep -oE 'https?://[^"<>\\[:space:]]{10,}' "$filepath" 2>/dev/null | \
        grep -vE 'localhost|127\.0\.0\.1|example\.com|\$|\\n' | \
        grep -E '\.(com|org|net|io|cloud|dev|co)/|github\.com' | \
        sort -u | head -5)

    # JIRA tickets
    jira=$(grep -oE '\b(PSEC|O11Y|INFRA|SEC|ENG|CLOUD)-[0-9]+\b' "$filepath" 2>/dev/null | \
        sort -u | tr '\n' ' ')

    # Git branches from metadata
    branches=$(grep -oE '"gitBranch":"[^"]+' "$filepath" 2>/dev/null | \
        sed 's/"gitBranch":"//' | \
        grep -v '^$' | sort -u | tr '\n' ' ')

    # Output
    [[ -n "$jira" ]] && echo "JIRA:${jira}"
    [[ -n "$branches" ]] && echo "BRANCH:${branches}"
    [[ -n "$urls" ]] && echo "URL:${urls}"
}

# Helper: Count messages in a session file
get_message_count() {
    local filepath="$1"
    local user_count assistant_count
    user_count=$(grep -c '"type":"user"' "$filepath" 2>/dev/null || echo 0)
    assistant_count=$(grep -c '"type":"assistant"' "$filepath" 2>/dev/null || echo 0)
    echo "${user_count}/${assistant_count}"
}

# Helper: Format file size
format_size() {
    local size=$1
    if (( size >= 1048576 )); then
        awk "BEGIN {printf \"%.1fM\", $size/1048576}"
    elif (( size >= 1024 )); then
        awk "BEGIN {printf \"%.1fK\", $size/1024}"
    else
        echo "${size}B"
    fi
}

# Helper: Shorten path for display
shorten_path() {
    local path="$1"
    path="${path/#$HOME\/workspace\/github.com\//gh:}"
    path="${path/#$HOME\/workspace\//ws:}"
    path="${path/#$HOME\//~/}"
    echo "$path"
}

# Helper: Parse date string to epoch seconds (macOS compatible)
# Supports formats: YYYY, YYYY.MM, YYYY.MM.DD (and legacy formats)
# Args: input, mode ("from" or "to")
#   - "from": returns start of period (beginning of year/month/day)
#   - "to": returns end of period (end of year/month/day)
parse_date() {
    local input="$1"
    local mode="${2:-from}"  # default to "from" behavior
    local epoch year month day

    # Normalize: remove ordinal suffixes (1st, 2nd, 3rd, 4th, etc)
    input=$(echo "$input" | sed -E 's/([0-9])(st|nd|rd|th)/\1/gi')

    # YYYY format (year only)
    if [[ "$input" =~ ^[0-9]{4}$ ]]; then
        year="$input"
        if [[ "$mode" == "to" ]]; then
            # End of year: Dec 31 23:59:59
            epoch=$(date -j -f "%Y-%m-%d %H:%M:%S" "$year-12-31 23:59:59" +%s 2>/dev/null)
        else
            # Start of year: Jan 1 00:00:00
            epoch=$(date -j -f "%Y-%m-%d" "$year-01-01" +%s 2>/dev/null)
        fi
        [[ -n "$epoch" ]] && echo "$epoch" && return 0
    fi

    # YYYY.MM format (year and month)
    if [[ "$input" =~ ^([0-9]{4})\.([0-9]{1,2})$ ]]; then
        year="${BASH_REMATCH[1]}"
        month="${BASH_REMATCH[2]}"
        # Pad month to 2 digits
        month=$(printf "%02d" "$month")
        if [[ "$mode" == "to" ]]; then
            # End of month: subtract 1 second from start of next month
            local next_month=$((10#$month + 1))
            local next_year="$year"
            if [[ $next_month -gt 12 ]]; then
                next_month=1
                next_year=$((year + 1))
            fi
            next_month=$(printf "%02d" "$next_month")
            local next_start
            next_start=$(date -j -f "%Y-%m-%d" "$next_year-$next_month-01" +%s 2>/dev/null)
            epoch=$((next_start - 1))
        else
            # Start of month: 1st day 00:00:00
            epoch=$(date -j -f "%Y-%m-%d" "$year-$month-01" +%s 2>/dev/null)
        fi
        [[ -n "$epoch" ]] && echo "$epoch" && return 0
    fi

    # YYYY.MM.DD format (full date with dots)
    if [[ "$input" =~ ^([0-9]{4})\.([0-9]{1,2})\.([0-9]{1,2})$ ]]; then
        year="${BASH_REMATCH[1]}"
        month=$(printf "%02d" "${BASH_REMATCH[2]}")
        day=$(printf "%02d" "${BASH_REMATCH[3]}")
        if [[ "$mode" == "to" ]]; then
            epoch=$(date -j -f "%Y-%m-%d %H:%M:%S" "$year-$month-$day 23:59:59" +%s 2>/dev/null)
        else
            epoch=$(date -j -f "%Y-%m-%d" "$year-$month-$day" +%s 2>/dev/null)
        fi
        [[ -n "$epoch" ]] && echo "$epoch" && return 0
    fi

    # Legacy: ISO format 2025-11-01
    if [[ "$input" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        if [[ "$mode" == "to" ]]; then
            epoch=$(date -j -f "%Y-%m-%d %H:%M:%S" "$input 23:59:59" +%s 2>/dev/null)
        else
            epoch=$(date -j -f "%Y-%m-%d" "$input" +%s 2>/dev/null)
        fi
        [[ -n "$epoch" ]] && echo "$epoch" && return 0
    fi

    # Legacy: US format 11/1/2025
    if [[ "$input" =~ ^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}$ ]]; then
        if [[ "$mode" == "to" ]]; then
            local parsed
            parsed=$(date -j -f "%m/%d/%Y" "$input" +"%Y-%m-%d" 2>/dev/null)
            epoch=$(date -j -f "%Y-%m-%d %H:%M:%S" "$parsed 23:59:59" +%s 2>/dev/null)
        else
            epoch=$(date -j -f "%m/%d/%Y" "$input" +%s 2>/dev/null)
        fi
        [[ -n "$epoch" ]] && echo "$epoch" && return 0
    fi

    # Legacy: "Month Day Year" format
    for fmt in "%B %d %Y" "%b %d %Y" "%d %B %Y" "%d %b %Y"; do
        local parsed
        parsed=$(date -j -f "$fmt" "$input" +"%Y-%m-%d" 2>/dev/null)
        if [[ -n "$parsed" ]]; then
            if [[ "$mode" == "to" ]]; then
                epoch=$(date -j -f "%Y-%m-%d %H:%M:%S" "$parsed 23:59:59" +%s 2>/dev/null)
            else
                epoch=$(date -j -f "%Y-%m-%d" "$parsed" +%s 2>/dev/null)
            fi
            [[ -n "$epoch" ]] && echo "$epoch" && return 0
        fi
    done

    return 1
}

# Helper: Get file modification time as epoch seconds (macOS)
get_file_mtime_epoch() {
    stat -f %m "$1" 2>/dev/null
}

# Helper: Get session start time as epoch seconds
# Extracts first timestamp from JSONL and converts UTC to local epoch
get_session_start_epoch() {
    local filepath="$1"
    local ts_utc epoch

    ts_utc=$(grep -m1 '"timestamp"' "$filepath" 2>/dev/null | \
        grep -o '"timestamp":"[^"]*"' | head -1 | cut -d'"' -f4)

    [[ -z "$ts_utc" ]] && return 1

    # Parse UTC timestamp and convert to epoch
    epoch=$(date -j -u -f "%Y-%m-%dT%H:%M:%S" "${ts_utc%%.*}" "+%s" 2>/dev/null)
    [[ -n "$epoch" ]] && echo "$epoch" && return 0
    return 1
}

# Helper: Get session start time formatted for display (local time)
get_session_start_display() {
    local filepath="$1"
    local epoch
    epoch=$(get_session_start_epoch "$filepath")
    [[ -z "$epoch" ]] && echo "" && return
    date -r "$epoch" "+%b %d %H:%M" 2>/dev/null
}

# Helper: Check if file is within date range
# Args: filepath, from_epoch, to_epoch, filter_mode (start|last)
file_in_date_range() {
    local filepath="$1"
    local from_epoch="$2"
    local to_epoch="$3"
    local filter_mode="$4"  # "start" or "last"
    local file_epoch

    # If no date filters, always return true
    [[ -z "$from_epoch" && -z "$to_epoch" ]] && return 0

    # Get the appropriate epoch based on filter mode
    if [[ "$filter_mode" == "start" ]]; then
        file_epoch=$(get_session_start_epoch "$filepath")
        # Fall back to mtime if no start timestamp
        [[ -z "$file_epoch" ]] && file_epoch=$(get_file_mtime_epoch "$filepath")
    else
        file_epoch=$(get_file_mtime_epoch "$filepath")
    fi

    [[ -z "$file_epoch" ]] && return 1

    # Check from date
    if [[ -n "$from_epoch" && "$file_epoch" -lt "$from_epoch" ]]; then
        return 1
    fi

    # Check to date
    if [[ -n "$to_epoch" && "$file_epoch" -gt "$to_epoch" ]]; then
        return 1
    fi

    return 0
}

# Search mode: scan message content and display matching lines with context
# Args: search_term, case_insensitive, from_epoch, to_epoch, filter_mode,
#        include_agents, current_dir_only, context_lines, max_per_session, short_paths
search_content() {
    local search_term="$1"
    local case_insensitive="$2"
    local from_epoch="$3"
    local to_epoch="$4"
    local filter_mode="$5"
    local include_agents="$6"
    local current_dir_only="$7"
    local context_lines="${8:-1}"
    local max_per_session="${9:-10}"
    local short_paths="${10:-false}"

    local search_dir="$PROJECTS_DIR"
    if [[ "$current_dir_only" == "true" ]]; then
        local cwd_encoded
        cwd_encoded=$(pwd | sed 's/^\///' | sed 's/[\/.]/-/g')
        search_dir="${PROJECTS_DIR}/-${cwd_encoded}"
        [[ ! -d "$search_dir" ]] && {
            echo "No sessions found for current directory" >&2
            return 1
        }
    fi

    # Default --from to 3 weeks ago if not specified
    if [[ -z "$from_epoch" ]]; then
        from_epoch=$(date -v-3w +%s 2>/dev/null)
    fi

    # Build file list sorted newest first
    local all_files
    if [[ "$include_agents" == "true" ]]; then
        all_files=$(find "$search_dir" -name "*.jsonl" -type f -print0 2>/dev/null | \
            xargs -0 ls -t 2>/dev/null)
    else
        all_files=$(find "$search_dir" -name "*.jsonl" -type f ! -name "agent-*.jsonl" -print0 2>/dev/null | \
            xargs -0 ls -t 2>/dev/null)
    fi

    local total_matches=0
    local total_sessions=0

    # Highlight escape codes
    local hl_on hl_off
    hl_on=$(printf '\033[1;31m')
    hl_off=$(printf '\033[0m')

    while IFS= read -r filepath; do
        [[ -z "$filepath" || ! -f "$filepath" ]] && continue

        # Date filter
        if ! file_in_date_range "$filepath" "$from_epoch" "$to_epoch" "$filter_mode"; then
            continue
        fi

        # Quick reject: does the file contain the term at all?
        local quick_grep_opts="-q"
        [[ "$case_insensitive" == "true" ]] && quick_grep_opts="-qi"
        if ! grep $quick_grep_opts "$search_term" "$filepath" 2>/dev/null; then
            continue
        fi

        # Extract project path for ignore check
        local project_path
        project_path=$(grep -m1 '"cwd"' "$filepath" 2>/dev/null | grep -o '"cwd":"[^"]*"' | cut -d'"' -f4)
        if [[ -n "$project_path" ]] && is_ignored "$project_path"; then
            continue
        fi

        # Extract all messages in one jq call: "idx\trole\tcontent" per line
        # Only user/assistant with string content
        local messages_tsv
        messages_tsv=$(jq -r '
            select(.type == "user" or .type == "assistant") |
            select(.message.content | type == "string") |
            [.type, (.message.content | gsub("\n"; " ") | gsub("\t"; " "))] |
            @tsv
        ' "$filepath" 2>/dev/null)

        [[ -z "$messages_tsv" ]] && continue

        # Convert to indexed arrays
        local -a msg_roles=()
        local -a msg_contents=()
        local msg_idx=0

        while IFS=$'\t' read -r role content; do
            [[ -z "$role" ]] && continue
            msg_roles[msg_idx]="$role"
            msg_contents[msg_idx]="$content"
            ((msg_idx++))
        done <<< "$messages_tsv"

        [[ $msg_idx -eq 0 ]] && continue

        local session_matches=0
        local header_printed=false
        local display_path

        if [[ "$short_paths" == "true" && -n "$project_path" ]]; then
            display_path=$(shorten_path "$project_path")
        elif [[ -n "$project_path" ]]; then
            display_path="$project_path"
        else
            display_path="[unknown]"
        fi

        local start_str
        start_str=$(get_session_start_display "$filepath")
        [[ -z "$start_str" ]] && start_str=$(stat -f "%Sm" -t "%b %d %H:%M" "$filepath" 2>/dev/null)

        # Search through collected messages
        local i
        for ((i=0; i<msg_idx; i++)); do
            local content="${msg_contents[$i]}"

            # Check if content matches
            local match_found=false
            if [[ "$case_insensitive" == "true" ]]; then
                echo "$content" | grep -qi "$search_term" 2>/dev/null && match_found=true
            else
                echo "$content" | grep -q "$search_term" 2>/dev/null && match_found=true
            fi

            if $match_found; then
                if ! $header_printed; then
                    printf "\n${C_GRAY}── ${C_CYAN}%s${C_GRAY} • ${C_CYAN}%s${C_GRAY} ──────────────────────────────────${C_RESET}\n" \
                        "$display_path" "$start_str"
                    header_printed=true
                    ((total_sessions++))
                fi

                # Context window
                local ctx_start=$((i - context_lines))
                [[ $ctx_start -lt 0 ]] && ctx_start=0
                local ctx_end=$((i + context_lines))
                [[ $ctx_end -ge $msg_idx ]] && ctx_end=$((msg_idx - 1))

                local j
                for ((j=ctx_start; j<=ctx_end; j++)); do
                    local ctx_role="${msg_roles[$j]}"
                    local ctx_content="${msg_contents[$j]}"
                    # Truncate long content
                    if [[ ${#ctx_content} -gt 200 ]]; then
                        ctx_content="${ctx_content:0:200}..."
                    fi

                    if [[ $j -eq $i ]]; then
                        # Highlight the search term in the matching line
                        local highlighted
                        if [[ "$case_insensitive" == "true" ]]; then
                            highlighted=$(echo "$ctx_content" | sed -E "s/($search_term)/${hl_on}\\1${hl_off}/gI" 2>/dev/null)
                            # macOS sed may not support I flag
                            [[ "$highlighted" == "$ctx_content" ]] && highlighted="$ctx_content"
                        else
                            highlighted=$(echo "$ctx_content" | sed -E "s/($search_term)/${hl_on}\\1${hl_off}/g" 2>/dev/null)
                        fi
                        printf "  ${C_BOLD}[%s]${C_RESET} %s\n" "$ctx_role" "$highlighted"
                    else
                        printf "  ${C_GRAY}[%s] %s${C_RESET}\n" "$ctx_role" "$ctx_content"
                    fi
                done

                ((session_matches++))
                ((total_matches++))

                if [[ $session_matches -ge $max_per_session ]]; then
                    # Count remaining matches
                    local remaining=0
                    local k
                    for ((k=i+1; k<msg_idx; k++)); do
                        if [[ "$case_insensitive" == "true" ]]; then
                            echo "${msg_contents[$k]}" | grep -qi "$search_term" 2>/dev/null && ((remaining++))
                        else
                            echo "${msg_contents[$k]}" | grep -q "$search_term" 2>/dev/null && ((remaining++))
                        fi
                    done
                    [[ $remaining -gt 0 ]] && \
                        printf "  ${C_GRAY}[%d more matches...]${C_RESET}\n" "$remaining"
                    break
                fi
            fi
        done
    done <<< "$all_files"

    if [[ $total_matches -eq 0 ]]; then
        echo "No content matches for '$search_term'" >&2
        return 1
    fi

    printf "\n${C_GRAY}%d matches in %d sessions${C_RESET}\n" "$total_matches" "$total_sessions"
}

# Main function
main() {
    local count=$DEFAULT_COUNT
    local include_agents=false
    local show_all=false
    local short_paths=false
    local verbose=false
    local json_output=false
    local fzf_mode=false
    local path_only=false
    local current_dir_only=false
    local search_pattern=""
    local search_content_term=""
    local search_context=1
    local search_max_per_session=10
    local case_insensitive=false
    local from_epoch=""
    local to_epoch=""
    local filter_mode="last"  # "start" or "last"
    local count_explicitly_set=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -a) include_agents=true; shift ;;
            --all) include_agents=true; show_all=true; shift ;;
            -s|--short) short_paths=true; shift ;;
            -v|--verbose) verbose=true; shift ;;
            -g|--grep)
                # Handle -g -i PATTERN or -g PATTERN
                if [[ "$2" == "-i" ]]; then
                    case_insensitive=true
                    search_pattern="$3"
                    shift 3
                else
                    search_pattern="$2"
                    shift 2
                fi
                ;;
            -S|--search) search_content_term="$2"; shift 2 ;;
            --context) search_context="$2"; shift 2 ;;
            --max-per-session) search_max_per_session="$2"; shift 2 ;;
            -i) case_insensitive=true; shift ;;
            -j|--json) json_output=true; shift ;;
            -f|--fzf) fzf_mode=true; shift ;;
            -n) count="$2"; count_explicitly_set=true; shift 2 ;;
            --from)
                from_epoch=$(parse_date "$2" "from")
                if [[ -z "$from_epoch" ]]; then
                    echo "Error: Could not parse date '$2'" >&2
                    echo "Formats: YYYY, YYYY.MM, YYYY.MM.DD (e.g., 2025, 2025.12, 2025.12.01)" >&2
                    return 1
                fi
                shift 2
                ;;
            --to)
                to_epoch=$(parse_date "$2" "to")
                if [[ -z "$to_epoch" ]]; then
                    echo "Error: Could not parse date '$2'" >&2
                    echo "Formats: YYYY, YYYY.MM, YYYY.MM.DD (e.g., 2025, 2025.12, 2025.12.01)" >&2
                    return 1
                fi
                shift 2
                ;;
            --by-start) filter_mode="start"; shift ;;
            --by-last) filter_mode="last"; shift ;;
            --here) current_dir_only=true; shift ;;
            --path-only) path_only=true; shift ;;
            --ignore)
                add_ignore "$2"
                return 0
                ;;
            --unignore)
                remove_ignore "$2"
                return 0
                ;;
            --list-ignored)
                list_ignored
                return 0
                ;;
            -h|--help)
                cat <<'HELP'
Usage: ccss [options] [count]

Browse and search recent Claude Code sessions from ~/.claude/projects

Options:
  -n COUNT       Number of sessions to show (default: 10, fzf mode: 100)
  -a             Include agent/subagent sessions
  --all          Include agents + show ALL sessions (no count limit)
  -s, --short    Use shortened paths (gh:, ws:, ~/)
  -v, --verbose  Show extra info (refs, file path, message count)
  -g, --grep     Search sessions for keyword (case-sensitive)
  -S, --search TERM  Search message content, show matching lines with context
  --context N    Messages of context around search matches (default: 1)
  --max-per-session N  Max matches per session (default: 10)
  -i             Case-insensitive search (use with -g or -S)
  -j, --json     Output as JSON (one object per line)
  -f, --fzf      Interactive fzf mode - filter and select session to resume
  --path-only    Show unique project paths with timestamps (for cd, not resume)
  --from DATE    Only show sessions on or after DATE
  --to DATE      Only show sessions on or before DATE
  --by-start     Filter date range by session start time
  --by-last      Filter date range by last activity (default)
  --here         Only show sessions for current directory
  --ignore PATH  Add a path to the global ignore list
  --unignore PATH  Remove a path from the ignore list
  --list-ignored Show all ignored paths
  -h, --help     Show this help

Date formats:
  YYYY         Year only (e.g., 2025)
  YYYY.MM      Year and month (e.g., 2025.12)
  YYYY.MM.DD   Full date (e.g., 2025.12.01)

Examples:
  ccss           # Show 10 most recent sessions
  ccss -n 20     # Show 20 most recent sessions
  ccss --all     # Show ALL sessions (including agents)
  ccss -s        # Use shortened paths
  ccss -v        # Show refs, file path, message counts
  ccss -g Tutor  # Case-sensitive search
  ccss -S '.pem'           # Search message content for '.pem'
  ccss -S terraform -i     # Case-insensitive content search
  ccss -S kubectl --here   # Content search scoped to current project
  ccss -S '.pem' --context 3  # Show ±3 surrounding messages
  ccss --here    # Sessions for current directory only
  ccss -j | jq   # JSON output for scripting
  ccss -f        # Interactive fzf picker, resume on selection
  ccss -f -n 50  # fzf with 50 sessions
  ccss --path-only          # List unique project paths
  ccss --path-only -f       # fzf picker for paths (cd to selection)
  ccss --ignore /path/to/hide   # Hide a path from results
  ccss --list-ignored           # Show ignored paths
  ccss --from 2025.11 --to 2025.12      # Nov-Dec 2025
  ccss --from 2025.12.01 --to 2025.12.05
  ccss --from 2025 --by-start           # All of 2025 by start
HELP
                return 0
                ;;
            [0-9]*) count="$1"; shift ;;
            *)
                echo "Unknown option: $1" >&2
                echo "Use -h for help" >&2
                return 1
                ;;
        esac
    done

    # fzf mode setup
    if $fzf_mode; then
        if ! command -v fzf &>/dev/null; then
            echo "Error: fzf is not installed. Install with: brew install fzf" >&2
            return 1
        fi
        # Use higher default count for fzf if not explicitly set
        if ! $count_explicitly_set; then
            count=$FZF_DEFAULT_COUNT
        fi
    fi

    # Search content mode: dispatch to search_content and exit
    if [[ -n "$search_content_term" ]]; then
        search_content "$search_content_term" "$case_insensitive" "$from_epoch" "$to_epoch" \
            "$filter_mode" "$include_agents" "$current_dir_only" "$search_context" \
            "$search_max_per_session" "$short_paths"
        return $?
    fi

    # --all flag: override count to unlimited (use a very large number)
    if $show_all; then
        count=999999
    fi

    # path-only mode: we need to scan more sessions to get enough unique paths
    # Store the desired unique path count, then scan more files
    local desired_path_count=0
    if $path_only; then
        desired_path_count=$count
        # Scan many more files to find unique paths (multiply by 10 as heuristic)
        count=$((count * 10))
        [[ $count -lt $FZF_DEFAULT_COUNT ]] && count=$FZF_DEFAULT_COUNT
    fi

    [[ ! -d "$PROJECTS_DIR" ]] && {
        echo "No Claude projects directory found at $PROJECTS_DIR" >&2
        return 1
    }

    # Get list of session files sorted by modification time
    local file_list
    local search_dir="$PROJECTS_DIR"

    # If --here flag, limit to current directory's project folder
    if $current_dir_only; then
        local cwd_encoded
        cwd_encoded=$(pwd | sed 's/^\///' | sed 's/[\/.]/-/g')
        search_dir="${PROJECTS_DIR}/-${cwd_encoded}"
        [[ ! -d "$search_dir" ]] && {
            echo "No sessions found for current directory" >&2
            return 1
        }
    fi

    # Build file list (bash 3 compatible)
    local files_str all_files matched_count=0

    # Get all files sorted by time
    if $include_agents; then
        all_files=$(find "$search_dir" -name "*.jsonl" -type f -print0 2>/dev/null | \
            xargs -0 ls -t 2>/dev/null)
    else
        all_files=$(find "$search_dir" -name "*.jsonl" -type f ! -name "agent-*.jsonl" -print0 2>/dev/null | \
            xargs -0 ls -t 2>/dev/null)
    fi

    # Determine if we need to filter files
    local needs_filtering=false
    [[ -n "$search_pattern" || -n "$from_epoch" || -n "$to_epoch" ]] && needs_filtering=true

    if $needs_filtering; then
        # Set up grep options if searching
        local grep_opts="-q"
        $case_insensitive && grep_opts="-qi"

        files_str=""
        while IFS= read -r f; do
            [[ -z "$f" ]] && continue

            # Check date range first (faster than grep)
            if ! file_in_date_range "$f" "$from_epoch" "$to_epoch" "$filter_mode"; then
                continue
            fi

            # Check grep pattern if specified
            if [[ -n "$search_pattern" ]]; then
                if ! grep $grep_opts "$search_pattern" "$f" 2>/dev/null; then
                    continue
                fi
            fi

            # File passed all filters
            files_str+="$f"$'\n'
            ((matched_count++))
            [[ $matched_count -ge $count ]] && break
        done <<< "$all_files"
    else
        # No filters - just get recent files
        files_str=$(echo "$all_files" | head -n "$count")
    fi

    # Convert to array (works in bash 3 - intentionally unquoted for word splitting)
    local IFS=$'\n'
    # shellcheck disable=SC2206
    file_list=($files_str)
    unset IFS

    [[ ${#file_list[@]} -eq 0 ]] && {
        local err_msg="No sessions found"
        [[ -n "$search_pattern" ]] && err_msg+=" matching '$search_pattern'"
        [[ -n "$from_epoch" || -n "$to_epoch" ]] && err_msg+=" in specified date range"
        echo "$err_msg" >&2
        return 1
    }

    # Collect fzf lines if in fzf mode
    local fzf_lines=""
    # Track seen paths for --path-only deduplication
    local seen_paths=""
    local unique_path_count=0

    # Process each file
    local filepath size size_human time_str start_str filename summary project_path display_path last_prompt msg_count
    for filepath in "${file_list[@]}"; do
        [[ -z "$filepath" || ! -f "$filepath" ]] && continue

        # Get file stats (macOS stat syntax)
        size=$(stat -f %z "$filepath" 2>/dev/null)
        time_str=$(stat -f "%Sm" -t "%b %d %H:%M" "$filepath" 2>/dev/null)
        start_str=$(get_session_start_display "$filepath")
        filename=$(basename "$filepath" .jsonl)

        # Extract metadata from JSONL
        summary=$(head -1 "$filepath" 2>/dev/null | jq -r '.summary // empty' 2>/dev/null | \
            sed 's/<system-reminder>.*//' | tr '\n' ' ' | sed 's/  */ /g' | head -c 70)
        project_path=$(grep -m1 '"cwd"' "$filepath" 2>/dev/null | jq -r '.cwd // empty' 2>/dev/null)
        last_prompt=$(get_last_prompt "$filepath")

        # Handle missing cwd field
        if [[ -z "$project_path" ]]; then
            # In path-only mode, skip sessions without valid cwd (can't reliably decode path)
            if $path_only; then
                continue
            fi
            # Fallback: show raw encoded directory name (don't try to decode - it's lossy)
            project_path="[encoded] $(basename "$(dirname "$filepath")")"
        fi

        # Skip ignored paths
        if is_ignored "$project_path"; then
            continue
        fi

        # Skip duplicate paths in --path-only mode
        if $path_only; then
            if [[ "$seen_paths" == *"|${project_path}|"* ]]; then
                continue
            fi
            seen_paths+="|${project_path}|"
            ((unique_path_count++))
            # Check if we have enough unique paths
            if [[ $desired_path_count -gt 0 && $unique_path_count -gt $desired_path_count ]]; then
                break
            fi
        fi

        # Choose display path based on -s flag
        if $short_paths; then
            display_path=$(shorten_path "$project_path")
        else
            display_path="$project_path"
        fi

        size_human=$(format_size "$size")

        if $json_output; then
            # JSON output - always include all data
            local refs_raw jira_json branch_json
            refs_raw=$(get_refs "$filepath")
            jira_json=$(echo "$refs_raw" | grep '^JIRA:' | sed 's/^JIRA://' | xargs | sed 's/ /","/g')
            branch_json=$(echo "$refs_raw" | grep '^BRANCH:' | sed 's/^BRANCH://' | xargs | sed 's/ /","/g')
            [[ -n "$jira_json" ]] && jira_json="[\"$jira_json\"]" || jira_json="[]"
            [[ -n "$branch_json" ]] && branch_json="[\"$branch_json\"]" || branch_json="[]"
            msg_count=$(get_message_count "$filepath")

            # shellcheck disable=SC2001
            printf '{"file":"%s","project":"%s","session_id":"%s","size":"%s","started":"%s","modified":"%s","messages":"%s","summary":"%s","last_prompt":"%s","jira":%s,"branches":%s}\n' \
                "$filepath" "$project_path" "$filename" "$size_human" "${start_str:-$time_str}" "$time_str" "$msg_count" \
                "$(echo "$summary" | sed 's/"/\\"/g')" \
                "$(echo "$last_prompt" | sed 's/"/\\"/g')" \
                "$jira_json" "$branch_json"
        elif $path_only; then
            # Path-only mode: timestamp + path (for cd, not resume)
            if $fzf_mode; then
                # fzf path selection: display path, tab + full path for extraction
                local fzf_line
                fzf_line=$(printf "%s  %s\t%s" "$time_str" "$display_path" "$project_path")
                fzf_lines+="$fzf_line"$'\n'
            else
                # Simple text output
                printf "${C_CYAN}%-12s${C_RESET}  %s\n" "$time_str" "$display_path"
            fi
        elif $fzf_mode; then
            # fzf output: single line with all searchable fields, session_id at end after tab
            local refs_raw jira_refs branch_refs date_display
            refs_raw=$(get_refs "$filepath")
            jira_refs=$(echo "$refs_raw" | grep '^JIRA:' | sed 's/^JIRA://' | xargs)
            branch_refs=$(echo "$refs_raw" | grep '^BRANCH:' | sed 's/^BRANCH://' | xargs)

            # Date display: prefer start time if available
            if [[ -n "$start_str" && "$start_str" != "$time_str" ]]; then
                date_display="${start_str}→${time_str}"
            else
                date_display="$time_str"
            fi

            # Format: date | size | path | summary | prompt | [jira] [branches] | session_id
            # Use tab before session_id for easy extraction
            local fzf_line
            fzf_line=$(printf "%s │ %5s │ %s │ %s │ %s" \
                "$date_display" "$size_human" "$display_path" \
                "${summary:-<no summary>}" "${last_prompt:-<no prompt>}")

            # Add refs if present (searchable but compact)
            [[ -n "$jira_refs" ]] && fzf_line+=" │ 🎫${jira_refs}"
            [[ -n "$branch_refs" ]] && fzf_line+=" │ 🌿${branch_refs}"

            # Tab + session_id at end (hidden from display width but searchable)
            fzf_line+=$'\t'"$filename"

            fzf_lines+="$fzf_line"$'\n'
        else
            # Human-readable output - show start→last if different, otherwise just one time
            if [[ -n "$start_str" && "$start_str" != "$time_str" ]]; then
                printf "${C_CYAN}%s${C_RESET}${C_GRAY}→${C_RESET}${C_CYAN}%-12s${C_RESET} ${C_YELLOW}%6s${C_RESET}  %s\n" \
                    "$start_str" "$time_str" "$size_human" "$display_path"
            else
                printf "${C_CYAN}%-12s${C_RESET} ${C_YELLOW}%6s${C_RESET}  %s\n" "$time_str" "$size_human" "$display_path"
            fi

            [[ -n "$summary" && "$summary" != " " ]] && \
                printf "                          ${C_GRAY}└─ %s${C_RESET}\n" "$summary"

            [[ -n "$last_prompt" ]] && \
                printf "                          ${C_MAGENTA}▶  %s${C_RESET}\n" "$last_prompt"

            # Verbose: show refs, message count, and file path
            if $verbose; then
                msg_count=$(get_message_count "$filepath")
                printf "                          ${C_GRAY}📊 %s messages (user/assistant)${C_RESET}\n" "$msg_count"

                local refs_output jira_refs branch_refs url_refs
                refs_output=$(get_refs "$filepath")
                if [[ -n "$refs_output" ]]; then
                    jira_refs=$(echo "$refs_output" | grep '^JIRA:' | sed 's/^JIRA://')
                    branch_refs=$(echo "$refs_output" | grep '^BRANCH:' | sed 's/^BRANCH://')
                    url_refs=$(echo "$refs_output" | grep '^URL:' | sed 's/^URL://' | head -c 100)

                    [[ -n "$jira_refs" ]] && \
                        printf "                          ${C_ORANGE}🎫 %s${C_RESET}\n" "$jira_refs"
                    [[ -n "$branch_refs" ]] && \
                        printf "                          ${C_GREEN}🌿 %s${C_RESET}\n" "$branch_refs"
                    [[ -n "$url_refs" ]] && \
                        printf "                          ${C_BLUE}🔗 %s${C_RESET}\n" "$url_refs"
                fi

                printf "                          ${C_GRAY}📁 %s${C_RESET}\n" "$filepath"
            fi

            printf "                          ${C_GRAY}   %s${C_RESET}\n" "$filename"
        fi
    done

    # Handle fzf selection
    if $fzf_mode && [[ -n "$fzf_lines" ]]; then
        local selected extracted fzf_prompt fzf_header

        if $path_only; then
            fzf_prompt="Select path > "
            fzf_header="Filter by path... Enter=output path, Esc=cancel"
        else
            fzf_prompt="Select session to resume > "
            fzf_header="Filter by path, summary, prompt, JIRA, branch... Enter=resume, Esc=cancel"
        fi

        selected=$(printf '%s' "$fzf_lines" | fzf \
            --height=80% \
            --layout=reverse \
            --border=rounded \
            --prompt="$fzf_prompt" \
            --header="$fzf_header" \
            --preview-window=hidden \
            --tabstop=1000 \
            --no-hscroll \
            --ansi)

        if [[ -n "$selected" ]]; then
            # Extract value after the tab (path or session_id)
            extracted=$(echo "$selected" | awk -F'\t' '{print $NF}')
            if [[ -n "$extracted" ]]; then
                if $path_only; then
                    # Output path for cd: cd $(ccss --path-only -f)
                    echo "$extracted"
                else
                    echo "Resuming session: $extracted"
                    exec claude --resume "$extracted"
                fi
            else
                echo "Error: Could not extract selection" >&2
                return 1
            fi
        else
            # Cancelled - silent exit for path-only (useful in cd $(...))
            $path_only || echo "No session selected" >&2
            return 0
        fi
    fi
}

# Only run main when executed directly, not when sourced
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
